# Copy to .env for local Docker Compose use. Do not commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
AUTOMATION_EMAIL_ENABLED=false
AUTOMATION_EMAIL_FROM=
GREENHOUSE_ENABLED=true
GREENHOUSE_BOARDS=
LEVER_ENABLED=true
LEVER_SITES=
RSS_JOB_FEEDS_ENABLED=true
RSS_JOB_FEEDS=
